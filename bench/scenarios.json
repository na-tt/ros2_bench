{
  "source": "assets/video/0000f77c-6257be58.mov",
  "rotate": 180,
  "duration_s": 120,
  "loops": 1000,
  "repeats": 3,
  "out_dir": "results/bench",
  "conditions": {
    "monolith": {
      "note": "single-process baseline",
      "cmd": [
        "{python}", "-m", "yolocar.main",
        "--source", "{source}",
        "--rotate", "{rotate}",
        "--loops", "{loops}",
        "--duration", "{duration}",
        "--records", "{out}/records.jsonl",
        "--json", "{out}/summary.json",
        "--log-level", "WARNING"
      ],
      "env": {"PYTHONPATH": "{repo}/monolith/yolocar/src"}
    },
    "monolith-ctrl": {
      "note": "byte-identical clone of `monolith`: the noise-floor control",
      "cmd": [
        "{python}", "-m", "yolocar.main",
        "--source", "{source}",
        "--rotate", "{rotate}",
        "--loops", "{loops}",
        "--duration", "{duration}",
        "--records", "{out}/records.jsonl",
        "--json", "{out}/summary.json",
        "--log-level", "WARNING"
      ],
      "env": {"PYTHONPATH": "{repo}/monolith/yolocar/src"}
    },
    "ros-short": {
      "enabled": false,
      "note": "placeholder: enable once ws/src/yolocar_ros exists. The node must write the same records.jsonl / summary.json contract.",
      "shell": "source {repo}/ws/install/setup.bash && ros2 launch yolocar_ros bench.launch.py duration:={duration} records:={out}/records.jsonl summary:={out}/summary.json"
    }
  }
}
