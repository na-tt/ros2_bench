<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yolocar_ros</name>
  <version>0.1.0</version>
  <description>
    ROS 2 wrapper for the yolocar pipeline. Four nodes, one per stage
    (acquisition, preprocessing, inference, postprocessing), call the stage
    functions from the installed `yolocar` Python project and add only ROS 2
    boilerplate plus the benchmark's records.jsonl / summary.json contract.
  </description>
  <maintainer email="panatt17@gmail.com">nat</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>yolocar_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
